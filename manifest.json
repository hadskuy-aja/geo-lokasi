{
  "manifest_version": 3,
  "name": "Ubah Lokasi",
  "version": "1.0.0",
  "description": "Ganti lokasi GPS yang dibaca website dengan klik titik di peta. Untuk uji coba fitur berbasis lokasi.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://nominatim.openstreetmap.org/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ubah Lokasi",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
